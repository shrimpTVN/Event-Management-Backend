<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===================== -->
    <!-- Environment-safe log path -->
    <!-- ===================== -->
    <property name="LOGS" value="${LOG_PATH:-./logs}"/>

    <!-- ===================== -->
    <!-- Console Appender -->
    <!-- ===================== -->
    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--            logging pattern when log into console-->
            <pattern>
                %green(%d{HH:mm:ss.SSS}) %blue(%-5level) %red([%thread]) %yellow(%logger{15}) - %cyan(%msg%n)
            </pattern>
        </encoder>
    </appender>

    <!-- ===================== -->
    <!-- Rolling File Appender -->
    <!-- ===================== -->
    <appender name="RollingFile"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOGS}/ddd.log</file>

        <encoder>
            <!--            logging pattern when log into log file-->
            <pattern>
                {"timestamp":"%d{yyyy-MM-dd HH:mm:ss}", "level":"%p", "logger":"%c", "message":"%m"}%n
            </pattern>
        </encoder>

        <!-- Modern rolling policy (size + time based) -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
<!--                file name format when archiving-->
                ${LOGS}/archived/ddd-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <maxFileSize>1MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!--Local development environment-->
    <springProfile name="default">
        <!-- ===================== -->
        <!-- Root Logger -->
        <!-- ===================== -->
        <root level="INFO">
            <appender-ref ref="Console"/>
            <appender-ref ref="RollingFile"/>
        </root>
        <!-- ===================== -->
        <!-- Application-specific INFO logs -->
        <!-- ===================== -->
        <logger name="com.ddd"
                level="INFO"
                additivity="false">
            <appender-ref ref="Console"/>
            <appender-ref ref="RollingFile"/>
        </logger>
    </springProfile>

<!--    Production environment-->
    <springProfile name="prod">
        <!-- ===================== -->
        <!-- Root Logger -->
        <!-- ===================== -->
        <root level="ERROR">
<!--            only recording ERROR log-->
            <appender-ref ref="RollingFile"/>
<!--            don't render logback on production environment-->
        </root>
        <!-- ===================== -->
        <!-- Application-specific ERROR logs -->
        <!-- ===================== -->
        <logger name="com.ddd"
                level="ERROR"
                additivity="false">
            <appender-ref ref="RollingFile"/>
        </logger>
    </springProfile>

<!--    Testing environment-->
    <springProfile name="qa">
        <!-- ===================== -->
        <!-- Root Logger -->
        <!-- ===================== -->
        <root level="INFO">
            <appender-ref ref="RollingFile"/>
        </root>
        <!-- ===================== -->
        <!-- Application-specific INFO logs -->
        <!-- ===================== -->
        <logger name="com.ddd"
                level="INFO"
                additivity="false">
            <appender-ref ref="RollingFile"/>
        </logger>
    </springProfile>

</configuration>
